<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Sistema de Gestão Acadêmica</title>
</head>
<body>
    <form>
        <p> 
            <label for="campo_login">Login</label>
            <input type="text" id="campo_login" name="Login">
        </p>

        <p>
            <label for="campo_senha">Senha</label>
            <input type="text" id="campo_senha" name="Senha">
        </p>

        <p>
            <label for="campo_status"> Status</label>
            <option value="Inativo"> Inativo</option>
            <option value="Ativo"> Ativo</option>
        </p>

        <p>
            <label for="campo_Tipo"> Perfil</label>
            <input type="radio" name=">
        </p>
    </form>
</body>
</html>
