</head>
<body>
    <form action="*">
        <p><b>MANUTENÇÃO DE USUÁRIOS DO SISTEMA INTERNO</b></p>
        
        <p> Login 
        <input type="text" name = "Login" size="15" maxlength="30">
        </p>
        
        <p>Senha
            <input type="text" name="Senha" size="15" maxlength="30">
        </p>

        <p>Status
            <select name="Status">
                <option value="Inativo"><b>Inativo</b></option>
                <option value="Ativo"><b>Ativo</b></option>
            </select>
        </p>

        <p>Tipo
            <input type="radio" name="area1" value="Técnico"> <b>Técnico</b> 
