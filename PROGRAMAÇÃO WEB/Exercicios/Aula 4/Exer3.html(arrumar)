            <input type="radio" name="area3" value="Aluno" > <b>Aluno</b> 
        </p>

            <p>Observações</p>
                <textarea name="comments" cols="20" rows="4"> </textarea>   

        <p>Modulos
        <input type="checkbox" name="modulo" value="Compras"> <b>Compras</b>
        <input type="checkbox" name="modulo2" value="Biblioteca"> <b>Biblioteca</b>
        <input type="checkbox" name="modulo3" value="Academico"> <b>Academico</b> <br>
        <input type="checkbox" name="modulo4" value="Documentacao"> <b>Documentacao</b>
        <input type="checkbox" name="modulo5" value="Recursos Humanos "> <b>Recursos Humanos </b>
        </p>
        
        <p>
            <input type="button" name="Cadastrar" value="Cadastrar" > <input type="button" name="Excluir" value="Excluir">
        </p>
        
         
    </form>
